# Copy this file to `.env` (git-ignored) and adjust if needed.
# No credentials/secrets are required by this project.
# Compose reads `.env` automatically for variable interpolation.

# Host port published for the Streamlit app
APP_PORT=8501

# Reproducibility
RANDOM_SEED=42
TEST_SIZE=0.2

# Official UCI dataset archive (only used by the trainer service)
DATASET_URL=https://archive.ics.uci.edu/static/public/45/heart+disease.zip
